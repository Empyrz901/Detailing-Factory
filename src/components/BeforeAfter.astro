---
const { item } = Astro.props;
const hasComparison = item.before && item.after;
const webpPath = (src) => src.replace(/\.jpe?g$/i, ".webp");
const smallWebpPath = (src) => src.replace(/\.jpe?g$/i, "-sm.webp");
const avifPath = (src) => src.replace(/\.jpe?g$/i, ".avif");
const smallAvifPath = (src) => src.replace(/\.jpe?g$/i, "-sm.avif");
---
<article class="before-after">
  {hasComparison ? (
    <div class="ba-frame" data-before-after>
      <picture>
        <source type="image/avif" srcset={`${smallAvifPath(item.after)} 640w, ${avifPath(item.after)} 1024w`} sizes="(max-width: 980px) calc(100vw - 32px), 720px" />
        <img src={webpPath(item.after)} srcset={`${smallWebpPath(item.after)} 640w, ${webpPath(item.after)} 1200w`} sizes="(max-width: 980px) calc(100vw - 32px), 720px" alt={`Après ${item.car}`} loading="lazy" width="1179" height="1553" />
      </picture>
      <div class="ba-before">
        <picture>
          <source type="image/avif" srcset={`${smallAvifPath(item.before)} 640w, ${avifPath(item.before)} 1024w`} sizes="(max-width: 980px) calc(100vw - 32px), 720px" />
          <img src={webpPath(item.before)} srcset={`${smallWebpPath(item.before)} 640w, ${webpPath(item.before)} 1200w`} sizes="(max-width: 980px) calc(100vw - 32px), 720px" alt={`Avant ${item.car}`} loading="lazy" width="1179" height="1553" />
        </picture>
      </div>
      <span class="ba-label before">Avant</span>
      <span class="ba-label after">Après</span>
      <input type="range" min="8" max="92" value="50" aria-label="Comparer avant et après" />
    </div>
  ) : (
    <div class="ba-placeholder" aria-label="Avant après en attente des photos client">
      <div>
        <span>Avant</span>
        <strong>Photo client à intégrer</strong>
      </div>
      <div>
        <span>Après</span>
        <strong>Même véhicule, même angle</strong>
      </div>
    </div>
  )}
  <div class="ba-copy">
    <p class="eyebrow">Prestation : {item.title}</p>
    <h3>{item.car}</h3>
    <p>{item.goal}</p>
  </div>
</article>
