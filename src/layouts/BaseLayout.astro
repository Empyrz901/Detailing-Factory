---
import "../styles/global.css";
import { business, whatsappUrl } from "@/data/site";

const {
  title = "Detailing automobile à Yverdon-les-Bains | Detailing Factory",
  description = "Detailing automobile à Yverdon-les-Bains : lavage, intérieur, polissage et protection céramique. Devis personnalisé sur WhatsApp.",
  canonical = Astro.url.pathname,
  robots = "index, follow"
} = Astro.props;

const canonicalUrl = new URL(canonical, Astro.site);
const socialImageUrl = new URL("/images/partage-detailing-factory.webp", Astro.site);
const heroImages = {
  "/": "/images/hero-home.webp",
  "/lavage-exterieur/": "/images/hero-wash.webp",
  "/tarifs/": "/images/hero-tariffs.webp"
};
const preloadHero = heroImages[Astro.url.pathname];
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Detailing Factory",
  url: Astro.site,
  inLanguage: "fr-CH"
};

const nav = [
  ["Accueil", "/"],
  ["Prestations", "/prestations/"],
  ["Tarifs", "/tarifs/"],
  ["Réalisations", "/realisations/"],
  ["Contact", "/contact/"]
];

const currentPath = Astro.url.pathname;
const servicePaths = ["/prestations/", "/lavage-exterieur/", "/interieur/", "/polissage/", "/protection/"];
const isCurrent = (href: string) => {
  if (href === "/") return currentPath === "/";
  if (href === "/prestations/") return servicePaths.some((path) => currentPath.startsWith(path));
  return currentPath.startsWith(href);
};
---
<!doctype html>
<html lang="fr-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr-CH" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/partage-detailing-factory.webp" />
    {preloadHero && <link rel="preload" as="image" href={preloadHero} type="image/webp" fetchpriority="high" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Detailing Factory" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Detailing Factory à Yverdon-les-Bains" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="theme-color" content="#101411" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark">DF</span>
        <span class="brand-name">Detailing <span>Factory</span></span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-navigation" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
      <nav class="main-nav" id="main-navigation" aria-label="Navigation principale" data-menu>
        {nav.map(([label, href]) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
        <a class="nav-cta" href="/reservation/" aria-current={isCurrent("/reservation/") ? "page" : undefined}>Prendre rendez-vous</a>
      </nav>
      <button class="menu-backdrop" type="button" aria-label="Fermer le menu" data-menu-backdrop></button>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>{business.name}</strong>
        <p>Brillance, protection et remise à neuf automobile à {business.city}.</p>
        <p>{business.address} · {business.partner}</p>
        <p><a href={`mailto:${business.email}`}>{business.email}</a></p>
      </div>
      <div>
        <a href="/a-propos/">À propos</a>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Confidentialité</a>
        <a href="/conditions/">Conditions de réservation</a>
      </div>
    </footer>
    <a class="floating-email" href={`mailto:${business.email}`} aria-label="Contacter Detailing Factory par email">Email</a>
    <nav class="mobile-bottom-nav" aria-label="Navigation mobile">
      <a href="/" aria-current={isCurrent("/") ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5V21h-6v-6H9v6H3Z" /></svg>
        <span>Accueil</span>
      </a>
      <a href="/prestations/" aria-current={isCurrent("/prestations/") ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h14" /></svg>
        <span>Services</span>
      </a>
      <a class="mobile-whatsapp" href={whatsappUrl("Bonjour Detailing Factory, je souhaite obtenir un devis.")} target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.73 13.61L3 21l4.5-1.18A9 9 0 1 0 12 3Z" /><path d="M8.5 8.2c.35 3.5 3.15 6.3 6.65 6.65l1.1-1.45-2.2-1.05-.85 1.05a7 7 0 0 1-2.6-2.6l1.05-.85-1.05-2.2Z" /></svg>
        <span>WhatsApp</span>
      </a>
      <a href="/tarifs/" aria-current={isCurrent("/tarifs/") ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4Z" /><path d="M8 10h8M8 14h5" /></svg>
        <span>Tarifs</span>
      </a>
      <a href="/contact/" aria-current={isCurrent("/contact/") ? "page" : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg>
        <span>Contact</span>
      </a>
    </nav>
    <script src="/scripts/interactions.js" defer></script>
  </body>
</html>
