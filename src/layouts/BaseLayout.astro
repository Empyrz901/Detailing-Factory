---
import "../styles/global.css";
import { business, whatsappUrl } from "@/data/site";

const {
  title = "Detailing Factory - Detailing automobile premium",
  description = "Detailing automobile premium, polissage, protection longue durée, lavage et intérieur sur rendez-vous.",
  canonical = Astro.url.pathname
} = Astro.props;

const nav = [
  ["Accueil", "/"],
  ["Prestations", "/prestations/"],
  ["Tarifs", "/tarifs/"],
  ["Réalisations", "/realisations/"],
  ["Contact", "/contact/"]
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonical, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#101411" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Accueil Detailing Factory">
        <span class="brand-mark">DF</span>
        <span class="brand-name">Detailing <span>Factory</span></span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Ouvrir le menu" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
      <nav class="main-nav" data-menu>
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        <a class="nav-cta" href="/reservation/">Prendre rendez-vous</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>{business.name}</strong>
        <p>Brillance, protection et remise à neuf automobile à {business.city}.</p>
        <p>{business.address} · {business.partner}</p>
      </div>
      <div>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Confidentialité</a>
        <a href="/conditions/">Conditions de réservation</a>
      </div>
    </footer>
    <a
      class="floating-whatsapp"
      href={whatsappUrl("Bonjour Detailing Factory, je souhaite obtenir un devis.")}
      target="_blank"
      rel="noopener"
      aria-label="Contacter Detailing Factory sur WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.79.47 3.47 1.29 4.93L2 22l5.29-1.38a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.14c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.8-4.17-4.94-4.36-.15-.19-1.18-1.57-1.18-3 0-1.42.75-2.13 1.02-2.42.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.81 2 .88 2.14.07.15.12.32.02.51-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.02 1.12.99 2.06 1.3 2.35 1.45.29.15.46.13.63-.08.17-.21.72-.84.91-1.13.19-.29.38-.24.63-.14.26.1 1.64.77 1.92.91.29.15.48.22.55.34.07.13.07.75-.17 1.43Z" />
      </svg>
      <span>Écrivez-nous</span>
    </a>
    <script src="/scripts/interactions.js" defer></script>
  </body>
</html>
