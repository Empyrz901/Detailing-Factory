---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
---
<BaseLayout title="À propos - Detailing Factory">
  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="À propos" title="Votre véhicule. Notre exigence du détail." text="Detailing Factory doit vendre une expertise, une méthode et un niveau d'attention, pas seulement des heures de lavage." />
      <div class="grid two">
        <article class="card"><h3>Méthode</h3><p>Chaque véhicule est évalué selon son état, sa taille, sa contamination, ses défauts et l'objectif du client.</p></article>
        <article class="card"><h3>Exigence</h3><p>Produits professionnels, gestes précis, finitions contrôlées et restitution sur rendez-vous.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
