---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
---
<BaseLayout title="Avis clients - Detailing Factory">
  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Avis clients" title="Ils nous font confiance" text="Les avis et chiffres doivent rester réels et vérifiables. Les cartes ci-dessous sont des emplacements à remplacer." />
      <div class="grid">
        <article class="card"><h3>Avis Google vérifié</h3><p>Ajouter ici un avis réel, avec prénom ou initiales si l'affichage est autorisé.</p></article>
        <article class="card"><h3>Avis Google vérifié</h3><p>Ajouter ici un avis réel, sans inventer de note, de volume ou d'ancienneté.</p></article>
        <article class="card"><h3>Avis Google vérifié</h3><p>Ajouter ici un avis réel centré sur le résultat, l'accueil et la qualité.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
