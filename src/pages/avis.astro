---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
---
<BaseLayout title="Avis clients - Detailing Factory" description="Les avis clients de Detailing Factory seront publiés ici après le lancement de l’activité." robots="noindex, follow">
  <section class="section">
    <div class="section-inner">
      <SectionTitle as="h1" eyebrow="Avis clients" title="Une page réservée aux retours authentiques" text="Les premiers avis vérifiés seront présentés ici après le lancement de l’activité." />
      <article class="card"><h3>Transparence avant tout</h3><p>Aucune note, aucun témoignage et aucun chiffre ne seront affichés sans retour client réel et autorisation de publication.</p></article>
    </div>
  </section>
</BaseLayout>
