---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { business, exteriorPrices, whatsappUrl } from "@/data/site";
---

<BaseLayout
  title={`Lavage extérieur à ${business.city} | Detailing Factory`}
  description={`Lavage extérieur automobile dans notre atelier à ${business.city}. Formule Express dès 59 CHF ou lavage complet dès 119 CHF.`}
>
  <section class="hero wash-hero">
    <div class="hero-layout">
      <div class="hero-inner">
        <p class="eyebrow">Service dans notre atelier à Yverdon-les-Bains</p>
        <h1>Lavage extérieur automobile à {business.city}</h1>
        <p class="lead">Un entretien express ou un nettoyage complet réalisé manuellement dans notre atelier.</p>
        <div class="hero-actions">
          <a class="button" href={whatsappUrl("Bonjour Detailing Factory, je souhaite un devis pour un lavage extérieur.")}>Réserver un lavage</a>
          <a class="button secondary" href="#formules">Voir les formules</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Tarif du lavage extérieur Express">
        <span>Formule Express</span>
        <strong>Lavage extérieur</strong>
        <p>Prélavage, mousse active, lavage manuel, rinçage et séchage complet.</p>
        <div>
          <small>À partir de</small>
          <b>59 CHF</b>
        </div>
        <a href="#formules">Comparer les formules</a>
      </aside>
    </div>
  </section>

  <section class="intro-strip" aria-label="Avantages du lavage extérieur">
    <div class="section-inner">
      <div><span>01</span><strong>Prise en charge à l’atelier</strong></div>
      <div><span>02</span><strong>Lavage manuel</strong></div>
      <div><span>03</span><strong>Produits professionnels</strong></div>
      <div><span>04</span><strong>Finition contrôlée</strong></div>
    </div>
  </section>

  <section class="section" id="formules">
    <div class="section-inner">
      <SectionTitle eyebrow="Deux formules" title="Express ou complet" />
      <div class="grid two">
        <article class="tariff-panel silver">
          <p class="eyebrow">Nettoyage extérieur Express</p>
          <h3>L'essentiel, propre et éclatant</h3>
          <ul>
            <li>Prélavage et mousse active</li>
            <li>Lavage manuel</li>
            <li>Rinçage et séchage</li>
            <li>Finition extérieure</li>
          </ul>
          <div class="mini-table">
            {exteriorPrices.filter((row) => row.express !== null).map((row) => (
              <div><span>{row.vehicle}</span><strong>{row.express} CHF</strong></div>
            ))}
          </div>
        </article>

        <article class="tariff-panel">
          <p class="eyebrow">Lavage complet</p>
          <h3>Un nettoyage en profondeur</h3>
          <ul>
            <li>Jantes, pneus et passages de roues</li>
            <li>Prélavage et mousse active</li>
            <li>Décontamination de la carrosserie</li>
            <li>Lavage manuel et séchage</li>
            <li>Recoins, vitres et finitions</li>
          </ul>
          <div class="mini-table">
            {exteriorPrices.map((row) => (
              <div><span>{row.vehicle}</span><strong>{row.complet} CHF</strong></div>
            ))}
          </div>
        </article>
      </div>
      <div class="actions">
        <a class="button" href={whatsappUrl("Bonjour Detailing Factory, je souhaite réserver un lavage extérieur. Voici mon véhicule et la formule qui m'intéresse : ")}>Demander un rendez-vous</a>
        <a class="button secondary" href="/tarifs/">Voir tous les tarifs</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <SectionTitle eyebrow="Lavage manuel" title="Une formule choisie selon l’état du véhicule" text="La taille du véhicule, son niveau de salissure et la finition souhaitée déterminent la formule la plus cohérente." />
      <div class="grid two">
        <article class="card">
          <h2>Quand choisir la formule Express ?</h2>
          <p>Elle convient à un entretien régulier lorsque la carrosserie ne présente pas de contamination importante. Le prélavage, le lavage manuel et le séchage permettent de retrouver rapidement un extérieur propre.</p>
        </article>
        <article class="card">
          <h2>Quand choisir le lavage complet ?</h2>
          <p>Il est recommandé lorsque les jantes, les passages de roues, les recoins ou la carrosserie demandent davantage de travail. Une décontamination est intégrée afin de préparer une surface plus nette.</p>
        </article>
      </div>
      <div class="actions"><a class="button secondary" href="/polissage/">Découvrir le polissage automobile</a></div>
    </div>
  </section>
</BaseLayout>
