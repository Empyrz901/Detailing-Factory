---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import { business, services, cases, faqs, whatsappUrl } from "@/data/site";
---

<BaseLayout>
  <section class="hero home-hero">
    <div class="hero-layout">
      <div class="hero-inner">
        <p class="eyebrow">Lavage · Polissage · Protection céramique</p>
        <h1>Detailing automobile <span>à Yverdon-les-Bains</span></h1>
        <p class="hero-tagline">Propre. Brillante. Protégée.</p>
        <p class="lead">Nettoyage intérieur et extérieur, polissage et protection réalisés avec soin, sur rendez-vous.</p>
        <div class="hero-actions">
          <a class="button" href={whatsappUrl("Bonjour Detailing Factory, je souhaite un devis. Je peux envoyer des photos de mon véhicule.")}>Demander un devis</a>
          <a class="button secondary" href="/realisations/">Voir les résultats</a>
        </div>
      </div>
      <aside class="hero-panel" aria-label="Prestation phare">
        <span>Prestation phare</span>
        <strong>Polissage en une étape</strong>
        <p>Correction légère et brillance intense.</p>
        <div><small>À partir de</small><b>450 CHF</b></div>
      </aside>
    </div>
  </section>

  <section class="intro-strip" aria-label="Informations essentielles">
    <div class="section-inner">
      <div><span>01</span><strong>Sur rendez-vous</strong></div>
      <div><span>02</span><strong>À Yverdon-les-Bains</strong></div>
      <div><span>03</span><strong>Devis sur photos</strong></div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Prestations" title="Prestations de detailing automobile" />
      <div class="grid two">
        {services.map((service) => (
          <a class="card" href={service.href}>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </a>
        ))}
      </div>
      <div class="actions"><a class="button secondary" href="/tarifs/">Voir tous les tarifs</a></div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <SectionTitle
        eyebrow="Detailing automobile"
        title="Une préparation adaptée à chaque véhicule"
        text="À Yverdon-les-Bains, nous intervenons sur rendez-vous après avoir identifié l’état du véhicule, vos priorités et le niveau de finition recherché."
      />
      <div class="grid three editorial-grid">
        <article class="card">
          <h3>Nettoyer sans négliger les détails</h3>
          <p>Un entretien extérieur commence par un lavage méthodique de la carrosserie, des jantes et des zones exposées aux salissures. Pour l’habitacle, le travail peut comprendre l’aspiration, le nettoyage des surfaces, des vitres, des tapis et des textiles. La formule est choisie selon l’usage du véhicule et son état réel.</p>
        </article>
        <article class="card">
          <h3>Corriger la finition</h3>
          <p>Le polissage sert à atténuer le voile terne, les tourbillons et une partie des micro-rayures. Une inspection permet de choisir entre une remise en brillance, un polissage en une étape ou une correction en deux étapes. Les défauts profonds sont signalés avant l’intervention afin de fixer un objectif réaliste.</p>
        </article>
        <article class="card">
          <h3>Protéger le résultat</h3>
          <p>Après la préparation, une protection céramique peut faciliter l’entretien courant et renforcer le comportement hydrophobe de la carrosserie. Sa durabilité dépend de la formule, de la préparation et du suivi. Nous expliquons les précautions utiles pour conserver une finition propre et régulière dans le temps.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Avant / Après" title="Résultats de polissage et nettoyage intérieur" text="Faites glisser le curseur pour comparer." />
      <div class="showcase-stack">
        {cases.map((item) => <BeforeAfter item={item} />)}
      </div>
      <div class="actions"><a class="button secondary" href="/realisations/">Toutes les réalisations</a></div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <SectionTitle
        eyebrow="Questions fréquentes"
        title="Questions sur le detailing automobile"
        text="Quelques réponses pour choisir une prestation et obtenir une estimation cohérente avant votre rendez-vous."
      />
      <div class="grid two faq-grid">
        {faqs.map((item) => (
          <article class="card">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner split">
      <SectionTitle eyebrow="Un tarif précis ?" title="Envoyez quelques photos" text="Indiquez le modèle, la prestation souhaitée et votre commune." />
      <div class="card compact-cta">
        <h3>{business.address}</h3>
        <p><strong>{business.partner}</strong></p>
        <p>Nous vous répondons avec une recommandation et une estimation adaptées au véhicule.</p>
        <a class="button" href={whatsappUrl("Bonjour Detailing Factory, je souhaite une estimation. Voici mon véhicule et les photos :")}>Écrire sur WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>
