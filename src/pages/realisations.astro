---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import { cases } from "@/data/site";
---
<BaseLayout title="Réalisations avant après - Detailing Factory">
  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Réalisations" title="Avant / Après" text="À compléter avec les vraies photos client : même véhicule, même angle, avant intervention puis après restitution." />
      {cases.map((item) => <BeforeAfter item={item} />)}
    </div>
  </section>
</BaseLayout>
