---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import PhotoGallery from "@/components/PhotoGallery.astro";
import { interiorCases, interiorGallery, interiorOptions, whatsappUrl } from "@/data/site";
---
<BaseLayout title="Nettoyage intérieur automobile à Yverdon | Detailing Factory" description="Nettoyage intérieur automobile à Yverdon-les-Bains : aspiration, habitacle, coffre, vitres et options textiles dès 60 CHF.">
  <section class="section">
    <div class="section-inner">
      <SectionTitle as="h1" eyebrow="Intérieur" title="Nettoyage intérieur automobile à Yverdon-les-Bains" text="Une formule soignée comprenant l’aspiration de l’habitacle et du coffre ainsi que le nettoyage des vitres intérieures et extérieures." />
      <div class="interior-price">
        <div>
          <p class="eyebrow">À partir de</p>
          <h3>60 CHF</h3>
          <p>Le tarif varie selon la taille du véhicule : citadine, berline ou espace / 4x4.</p>
          <div class="vehicle-strip">
            <div><span>Citadine</span><strong>60 CHF</strong></div>
            <div><span>Berline</span><strong>80 CHF</strong></div>
            <div><span>Espace / 4x4</span><strong>100 CHF</strong></div>
          </div>
        </div>
        <div class="big-price"><span>à partir de</span><strong>60</strong><em>CHF</em></div>
      </div>
      <SectionTitle eyebrow="Options" title="Ajoutez vos options à la carte" />
      <div class="option-grid">
        {interiorOptions.map((option) => <article><h3>{option.name}</h3><strong>{option.price} CHF</strong></article>)}
      </div>
      <div class="result-box" style="margin-top:24px">
        <span>Votre intérieur est très sale ?</span>
        <strong>Envoyez des photos</strong>
        <small>Une estimation personnalisée évite les incompréhensions avant rendez-vous.</small>
      </div>
      <div class="actions"><a class="button" href={whatsappUrl("Bonjour Detailing Factory, je souhaite une estimation pour un detailing intérieur. Je vais envoyer des photos.")}>Envoyer mes photos</a></div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <SectionTitle eyebrow="Detailing intérieur" title="Une intervention adaptée aux matériaux et aux salissures" text="L’état des sièges, tapis, plastiques et zones de contact est vérifié avant de recommander les options utiles." />
      <div class="grid two">
        <article class="card">
          <h2>Ce que comprend la formule</h2>
          <p>L’aspiration concerne l’habitacle et le coffre. Les surfaces accessibles et les vitres sont nettoyées avec une méthode adaptée, puis les finitions sont contrôlées avant la restitution du véhicule.</p>
        </article>
        <article class="card">
          <h2>Quand prévoir des options ?</h2>
          <p>Les taches incrustées, les poils d’animaux, les sièges en tissu ou le plafonnier demandent un traitement supplémentaire. Des photos permettent de confirmer le travail nécessaire et d’éviter un supplément imprévu.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Avant / Après" title="Le nettoyage en détail" text="Sièges, tapis et contre-portes : comparez la même zone avant et après intervention." />
      <div class="showcase-stack">
        {interiorCases.slice(0, 2).map((item) => <BeforeAfter item={item} />)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="section-inner">
      <SectionTitle eyebrow="Réalisations" title="Habitacles nettoyés" text="Quelques vues d'ensemble et détails de véhicules traités par Detailing Factory." />
      <PhotoGallery items={interiorGallery.slice(0, 6)} labelledBy="galerie-habitacles" />
      <span id="galerie-habitacles" class="sr-only">Galerie des habitacles nettoyés</span>
      <div class="actions"><a class="button secondary" href="/realisations/">Voir toutes les réalisations</a></div>
    </div>
  </section>
</BaseLayout>
