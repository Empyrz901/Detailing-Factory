---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import PhotoGallery from "@/components/PhotoGallery.astro";
import { business, polishingCases, polishingGallery, polishingPrices, whatsappUrl } from "@/data/site";
---
<BaseLayout title={`Polissage automobile à ${business.city} | Detailing Factory`} description={`Polissage automobile à ${business.city}. Brillance express, correction en une ou deux étapes et traitement des micro-rayures sur rendez-vous.`}>
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Polissage voiture dans le {business.city}</p>
      <h1>Polissage en une étape</h1>
      <p class="lead">Éliminer les micro-rayures, raviver la brillance et redonner de l'éclat à votre véhicule.</p>
      <div class="hero-actions">
        <a class="button" href="/tarifs/">Voir les tarifs</a>
        <a class="button secondary" href={whatsappUrl("Bonjour Detailing Factory, je souhaite un devis pour un polissage voiture.")}>Envoyer des photos</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Méthode" title="Micro-rayures, voile terne, manque de profondeur" text="Le polissage améliore la lisibilité de la peinture et restaure une finition plus nette. Le niveau dépend de l'état du véhicule." />
      <div class="steps">
        <div class="step"><div><h3>Analyse</h3><p>Inspection visuelle, photos ou contrôle sur place pour comprendre les défauts.</p></div></div>
        <div class="step"><div><h3>Préparation</h3><p>Lavage, décontamination et masquage des zones sensibles.</p></div></div>
        <div class="step"><div><h3>Correction</h3><p>Brillance express, polissage en une étape ou en deux étapes selon l'objectif.</p></div></div>
        <div class="step"><div><h3>Finition</h3><p>Contrôle du résultat et recommandation de protection.</p></div></div>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="section-inner">
      <SectionTitle eyebrow="Avant / Après" title="Voir la correction" text="Des résultats réels photographiés sur les mêmes zones avant et après polissage." />
      <div class="showcase-stack">
        {polishingCases.slice(0, 2).map((item) => <BeforeAfter item={item} />)}
      </div>
      <h2 class="gallery-heading" id="etapes-polissage">Préparation, correction, finition</h2>
      <PhotoGallery items={polishingGallery.slice(0, 6)} labelledBy="etapes-polissage" />
      <div class="actions"><a class="button secondary" href="/realisations/">Voir toutes les réalisations</a></div>
    </div>
  </section>
  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Tarifs polissage" title="Choisir le bon niveau de correction" />
      <div class="price-table wide">
        <div class="price-row head"><span>Prestation</span><span>Citadine</span><span>Berline</span><span>SUV</span><span>Grand SUV</span></div>
        {polishingPrices.map((row) => (
          <div class="price-row">
            <span><strong>{row.service}</strong><small>{row.detail}</small></span>
            <span><strong>{row.citadine} CHF</strong></span>
            <span><strong>{row.berline} CHF</strong></span>
            <span><strong>{row.suv} CHF</strong></span>
            <span><strong>{row.grand_suv} CHF</strong></span>
          </div>
        ))}
      </div>
      <div class="actions"><a class="button" href={whatsappUrl("Bonjour Detailing Factory, je souhaite savoir si mon véhicule a besoin d'une brillance express, d'un polissage en une étape ou en deux étapes.")}>Demander conseil</a></div>
    </div>
  </section>
</BaseLayout>
