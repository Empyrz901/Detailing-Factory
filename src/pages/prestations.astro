---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { services, whatsappUrl } from "@/data/site";
---
<BaseLayout title="Prestations detailing automobile - Detailing Factory">
  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Prestations" title="Quatre services, simplement" text="Choisissez votre besoin principal. Nous adaptons ensuite la formule à votre véhicule." />
      <div class="grid two">
        {services.map((service) => (
          <a class="card" href={service.href}><h3>{service.title}</h3><p>{service.text}</p></a>
        ))}
      </div>
      <div class="actions">
        <a class="button" href="/tarifs/">Voir les tarifs</a>
        <a class="button secondary" href={whatsappUrl("Bonjour Detailing Factory, je souhaite être conseillé sur une prestation.")}>Demander conseil</a>
      </div>
    </div>
  </section>
</BaseLayout>
