---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import { whatsappUrl } from "@/data/site";
---
<BaseLayout title="Prendre rendez-vous - Detailing Factory">
  <section class="section">
    <div class="section-inner">
      <SectionTitle eyebrow="Rendez-vous" title="Préparer votre demande" text="Cette V1 qualifie la demande avant passage sur WhatsApp. Un calendrier connecté pourra être ajouté ensuite." />
      <form class="card" action={whatsappUrl("Bonjour Detailing Factory, je souhaite prendre rendez-vous.")}>
        <div class="form-grid">
          <label class="field">Véhicule<input name="vehicule" placeholder="Ex. BMW Série 3" /></label>
          <label class="field">Prestation souhaitée<select name="prestation"><option>Lavage</option><option>Intérieur</option><option>Polissage</option><option>Protection</option><option>Je ne sais pas</option></select></label>
          <label class="field">Date souhaitée<input name="date" type="date" /></label>
          <label class="field">Téléphone<input name="telephone" placeholder="+41..." /></label>
          <label class="field">Nom<input name="nom" /></label>
          <label class="field">Email<input name="email" type="email" /></label>
        </div>
        <label class="field" style="margin-top:14px">Message<textarea name="message" placeholder="État du véhicule, objectif, contraintes horaires..."></textarea></label>
        <div class="actions">
          <a class="button" href={whatsappUrl("Bonjour Detailing Factory, je souhaite prendre rendez-vous. Voici mon véhicule et ma prestation souhaitée :")}>Continuer sur WhatsApp</a>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
